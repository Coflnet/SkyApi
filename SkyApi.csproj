<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <UserSecretsId>028d40f2-90db-43fb-b69e-fb2965e2568b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Coflnet.Core" Version="0.7.4" />
    <ProjectReference Include="../dev/hypixel.csproj" />
    <ProjectReference Include="../SkyBackendForFrontend/SkyBackendForFrontend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- golden planner answers used by the tests only, found by walking up from the test output -->
    <Content Remove="Fixtures\**" />
    <None Remove="Fixtures\**" />
  </ItemGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Client\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Coflnet.Sky.Bazaar.Flipper.Client" Version="0.11.0" />
    <PackageReference Include="Coflnet.DiscordBot.Client" Version="0.1.0" />
    <PackageReference Include="Coflnet.Payments.Client" Version="0.29.0" />
    <PackageReference Include="Coflnet.Sky.Indexer.Client" Version="0.2.0" />
    <PackageReference Include="Coflnet.Sky.ModCommands.Client" Version="0.11.0" />
    <PackageReference Include="Coflnet.Sky.PlayerState.Client" Version="0.19.0" />
    <PackageReference Include="Coflnet.Sky.Proxy.Client" Version="1.2.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Coflnet.Sky.Subscriptions.Client" Version="1.1.0" />
    <PackageReference Include="Coflnet.Sky.Trade.Client" Version="0.2.0" />
    <PackageReference Include="Hashids.net" Version="1.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="**\*.Tests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

</Project>
